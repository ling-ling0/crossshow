# CrossShow 服务端配置示例。复制为 deploy/.env 后按实际值修改。
# 配置不写入客户端代码；客户端通过设置页输入服务器 URL（开发文档 6.3 / 9.2）。

# 宿主机对外暴露端口（部署前核实阿里云安全组是否放行，文档 9.1）
CROSSSHOW_PUBLIC_PORT=8080

# 默认日历时区（首版固定，各端统一使用，文档 2.2）
CROSSSHOW_DEFAULT_TIMEZONE=Asia/Shanghai

# 日志等级：debug | info | warn | error
CROSSSHOW_LOG_LEVEL=info

# 优雅关闭等待上限
CROSSSHOW_SHUTDOWN_TIMEOUT=15s
